extends Node

## Autoload singleton name: BoardManager
##
## Owns the persistent board. A turn's new letter drops into a chosen column
## and falls to the lowest empty cell in it (Connect-4 gravity) — the player
## picks a column, not a specific cell. The board never clears; it only fills
## up, until every column is full, which is the game's end condition.

const COLUMNS := 8
const ROWS := 8

# Rough English letter frequency, weighted by repetition in this pool string.
const LETTER_BAG := "EEEEEEEEEEEEAAAAAAAAAIIIIIIIIIOOOOOOOONNNNNNRRRRRRTTTTTTLLLLSSSSUUUUDDDDGGGBBCCMMPPFFHHVVWWYYKJXQZ"

var grid: Array = [] # grid[column][row] = BoardCell

func _ready() -> void:
	grid.resize(COLUMNS)
	for c in range(COLUMNS):
		var column_cells: Array = []
		column_cells.resize(ROWS)
		for r in range(ROWS):
			column_cells[r] = BoardCell.new(c, r)
		grid[c] = column_cells

func draw_letter_from_bag() -> String:
	return LETTER_BAG[randi() % LETTER_BAG.length()]

func is_column_full(column: int) -> bool:
	if column < 0 or column >= COLUMNS:
		return true
	return not grid[column][ROWS - 1].is_empty()

## Drops a letter into the given column. Returns the row it settled at, or -1
## if the column is already full (caller should ask the player to pick another).
func drop_letter_in_column(column: int, letter: String) -> int:
	if column < 0 or column >= COLUMNS:
		return -1
	for r in range(ROWS):
		if grid[column][r].is_empty():
			grid[column][r].place_letter(letter)
			return r
	return -1

func has_any_empty_cell() -> bool:
	for c in range(COLUMNS):
		if not is_column_full(c):
			return true
	return false

func get_cell(column: int, row: int) -> BoardCell:
	if not _in_bounds(column, row):
		return null
	return grid[column][row]

func _in_bounds(column: int, row: int) -> bool:
	return column >= 0 and column < COLUMNS and row >= 0 and row < ROWS

## Any-direction adjacency check: each next cell in a path must be orthogonally
## or diagonally adjacent to the previous one, and no cell may repeat.
func is_path_connected_and_distinct(path: Array) -> bool:
	var seen := {}
	for i in range(path.size()):
		var cell: BoardCell = path[i]
		if seen.has(cell):
			return false
		seen[cell] = true
		if i == 0:
			continue

		var prev: BoardCell = path[i - 1]
		var dc: int = abs(cell.column - prev.column)
		var dr: int = abs(cell.row - prev.row)
		var adjacent: bool = dc <= 1 and dr <= 1 and (dc + dr) > 0
		if not adjacent:
			return false
	return true

## Traces a path for a typed word (which arrives with no path attached).
## Returns the first valid occurrence found, in any direction, or an empty
## array if the word doesn't currently exist on the board.
func find_path_for_word(word: String) -> Array:
	if word.is_empty():
		return []
	var upper := word.to_upper()

	for c in range(COLUMNS):
		for r in range(ROWS):
			var cell: BoardCell = grid[c][r]
			if cell.is_empty() or cell.letter != upper[0]:
				continue
			var path: Array = [cell]
			var found := _try_extend_path(path, upper, 1)
			if not found.is_empty():
				return found
	return []

func _try_extend_path(path: Array, word: String, next_index: int) -> Array:
	if next_index == word.length():
		return path

	var last: BoardCell = path[path.size() - 1]
	for dc in range(-1, 2):
		for dr in range(-1, 2):
			if dc == 0 and dr == 0:
				continue
			var candidate := get_cell(last.column + dc, last.row + dr)
			if candidate == null or candidate.is_empty() or path.has(candidate):
				continue
			if candidate.letter != word[next_index]:
				continue

			path.append(candidate)
			var result := _try_extend_path(path, word, next_index + 1)
			if not result.is_empty():
				return result
			path.pop_back()
	return []

## Scans the whole board for every currently valid, not-yet-claimed word.
## Used by AIOpponent to decide what it "notices" — never used for human
## input, since a human should never get a computed hint list.
func find_all_valid_words() -> Array:
	var results: Array = []
	var seen_words := {}

	for c in range(COLUMNS):
		for r in range(ROWS):
			var cell: BoardCell = grid[c][r]
			if cell.is_empty():
				continue
			var path: Array = [cell]
			_scan_from(path, seen_words, results)
	return results

func _scan_from(path: Array, seen_words: Dictionary, results: Array) -> void:
	var word := _build_word(path)
	if path.size() >= 3 and not seen_words.has(word) and not ScoreManager.is_word_already_claimed(word) \
			and WordValidator.is_valid_word(word):
		seen_words[word] = true
		results.append({"word": word, "path": path.duplicate()})

	if path.size() >= 12: # sane upper bound, avoids runaway recursion
		return

	var last: BoardCell = path[path.size() - 1]
	for dc in range(-1, 2):
		for dr in range(-1, 2):
			if dc == 0 and dr == 0:
				continue
			var candidate := get_cell(last.column + dc, last.row + dr)
			if candidate == null or candidate.is_empty() or path.has(candidate):
				continue

			path.append(candidate)
			_scan_from(path, seen_words, results)
			path.pop_back()

func _build_word(path: Array) -> String:
	var s := ""
	for cell in path:
		s += cell.letter
	return s

## Text rendering of the board, top row first — useful for the debug harness
## and for console/print-based testing before any real art exists.
func get_board_text() -> String:
	var lines: Array[String] = []
	for r in range(ROWS - 1, -1, -1):
		var row_str := ""
		for c in range(COLUMNS):
			var cell: BoardCell = grid[c][r]
			row_str += (cell.letter if not cell.is_empty() else ".") + " "
		lines.append(row_str)
	return "\n".join(lines)
