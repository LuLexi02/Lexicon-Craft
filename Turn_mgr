extends Node

## Autoload singleton name: TurnManager
##
## Drives the turn cadence for PvP: draw a letter, wait for the active player
## to pick a column, let them hunt/queue words freely, then run the 2-second
## confirmation buffer before committing and handing over to the other player.
## AIOpponent drives this same public API from the bot's side of a turn for
## solo mode.

signal turn_began(active_player: ScoreManager.PlayerId)
signal turn_committed(player: ScoreManager.PlayerId, points_this_turn: int)
signal game_over

const END_OF_GO_BUFFER_SECONDS := 2.0

var active_player: ScoreManager.PlayerId = ScoreManager.PlayerId.SEEKER_ONE
var pending_letter: String = ""
var awaiting_column_choice: bool = false
var awaiting_confirm_buffer: bool = false
var is_game_over: bool = false

func _ready() -> void:
	_begin_turn()

func _begin_turn() -> void:
	if not BoardManager.has_any_empty_cell():
		is_game_over = true
		game_over.emit()
		return

	pending_letter = BoardManager.draw_letter_from_bag()
	awaiting_column_choice = true
	turn_began.emit(active_player)

## Called by the input layer when the active player taps a column to drop
## this turn's letter into. Returns false if that column is already full.
func choose_column(column: int) -> bool:
	if not awaiting_column_choice:
		return false
	if BoardManager.is_column_full(column):
		return false

	BoardManager.drop_letter_in_column(column, pending_letter)
	awaiting_column_choice = false
	# Hunting phase now open — WordInputController can start queuing words.
	return true

## Player declares they're done finding words for this go. Starts the short
## personal confirmation window before the turn actually commits.
func request_end_go() -> void:
	if awaiting_column_choice or awaiting_confirm_buffer:
		return

	awaiting_confirm_buffer = true
	await get_tree().create_timer(END_OF_GO_BUFFER_SECONDS).timeout
	if awaiting_confirm_buffer: # guard in case cancel_end_go() was called during the wait
		_commit_and_advance()

## Lets the player back out of the buffer to keep editing, if your UI wants that.
func cancel_end_go() -> void:
	awaiting_confirm_buffer = false

func _commit_and_advance() -> void:
	awaiting_confirm_buffer = false

	var points_this_turn := 0
	for word in ScoreManager.current_turn_queue:
		points_this_turn += word.length()

	var just_played := active_player
	ScoreManager.commit_turn(just_played)
	turn_committed.emit(just_played, points_this_turn)

	active_player = ScoreManager.PlayerId.SEEKER_TWO if active_player == ScoreManager.PlayerId.SEEKER_ONE \
		else ScoreManager.PlayerId.SEEKER_ONE
	_begin_turn()
